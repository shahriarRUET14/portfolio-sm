# Copy to .env.local (git-ignored) for local development and Docker Compose.
# In production, add the same keys in Vercel → Project → Settings →
# Environment Variables.

# --- Contact form (Resend, https://resend.com) — runtime, server-only ---
# Secret API key. Never prefix it with NEXT_PUBLIC_ (that would ship it to browsers).
RESEND_API_KEY=
# Optional. Where messages are delivered (defaults to the email in content/profile.ts).
CONTACT_TO_EMAIL=
# Optional. Sender address. Defaults to Resend's test sender, which can only
# deliver to your own Resend account email until you verify a domain.
CONTACT_FROM_EMAIL=

# --- Build-time values (baked into the pages during `next build`) ---
# Public production URL for canonical links, sitemap and social cards.
# Defaults to https://portfolio-sm-ten.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=
# Google Search Console "HTML tag" verification token (content value only).
GOOGLE_SITE_VERIFICATION=
