# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Public production URL, used for canonical links, sitemap and social cards.
# Defaults to https://portfolio-sm-ten.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=

# EmailJS (https://www.emailjs.com) — powers the contact form.
# The template should accept user_name, user_email and user_message.
# If any of these are missing, the form is hidden and visitors see the
# direct email link instead.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Search Console "HTML tag" verification token (content value only).
GOOGLE_SITE_VERIFICATION=
